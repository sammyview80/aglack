# Environment for deploy/docker-compose.yml (the gateway only —
# OpenConnector is a separate, already-running instance you host
# elsewhere, not started by this compose file; see
# ../rust_gateway/.env.example's OPENCONNECTOR_URL comment).
# Copy to .env for compose to pick up automatically:
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env up -d
# .env is gitignored (see ../.gitignore's ".env.*" rule); never commit real
# values. Mirrors ../rust_gateway/.env.example's style: no baked-in
# defaults, no secrets hardcoded in docker-compose.yml itself.

# ── OpenConnector (remote — see ../docs/integrations-plan.md's security model) ──
# Real, reachable URL of your hosted OpenConnector instance, e.g.
# https://connector.example.com. Not run by this compose file.
OPENCONNECTOR_URL=

# OpenConnector's ADMIN-scoped API bearer, issued by whoever hosts it —
# never forwarded to a browser or a workspace container. See
# ../rust_gateway/.env.example's OPENCONNECTOR_ADMIN_TOKEN comment for why
# this must be the admin/management credential, not a narrower runtime
# token.
OPENCONNECTOR_ADMIN_TOKEN=

# ── Gateway ──────────────────────────────────────────────────────────────
# This gateway's own real, reachable public URL — NOT read by the gateway
# process itself, but whoever hosts your OpenConnector instance needs this
# exact value for THEIR OWN OOMOL_CONNECT_ORIGIN setting (see
# ../rust_gateway/.env.example's OPENCONNECTOR_ADMIN_TOKEN comment for the
# full OAuth-callback explanation). Kept here only as a reminder of what
# value to hand them; changing it in this file alone does nothing on its
# own.
GATEWAY_PUBLIC_URL=http://localhost:8080

# Full Argon2id PHC-format hash — generate with:
#   cargo run --bin rust_gateway -- --hash-password 'your password'
# Never a plaintext password here.
GATEWAY_ADMIN_PASSWORD_HASH=

# AES-256-GCM key encrypting workspace_runtime_tokens.openconnector_bearer
# at rest in the gateway's own SQLite store. Generate with:
#   openssl rand -base64 32
GATEWAY_TOKEN_ENCRYPTION_KEY=

# Host/port the gateway process binds to inside its container, and the
# host port it is published on (see docker-compose.yml's gateway.ports).
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# Origin allowed to make browser (CORS) requests to this gateway — see
# ../rust_gateway/.env.example's FRONTEND_ORIGIN for the exact matching
# rules (scheme+host+port, "localhost" not "127.0.0.1").
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_PORT=80
VITE_GATEWAY_URL=https://app.example.com
GATEWAY_COOKIE_SECURE=true

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/auth/google/callback
GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo

# Fixed backend this test slice forwards to (see
# ../rust_gateway/.env.example's GATEWAY_BACKEND_HOST/PORT). Point this at
# a real wrapper container's published port for anything beyond the
# throwaway test_backend stand-in.
GATEWAY_BACKEND_HOST=127.0.0.1
GATEWAY_BACKEND_PORT=8797

# Path to the provider catalog, as seen from wherever the gateway process
# runs INSIDE its container — mount/copy backend/integrations/providers.yaml
# into the image at this path, or bind-mount it, matching whatever the
# Dockerfile at ../rust_gateway does. Left as a placeholder here; do not
# assume a value not already established by the build.
INTEGRATIONS_PROVIDERS_PATH=./providers.yaml

# Docker image tag to launch workspace containers from (see
# ../rust_gateway/.env.example — same value, same build step required
# first: docker build -t hermes-workspace:dev -f
# ../backend/workspace-image/Dockerfile ../backend).
WORKSPACE_IMAGE_TAG=hermes-workspace:dev

# Default agent workspace directory inside a workspace container. See
# ../rust_gateway/.env.example for the full explanation.
WORKSPACE_DEFAULT_PATH=/workspace/default

# Optional Docker network for workspace containers. In a Compose deployment,
# use this project's default network (normally `<project>_default`) and the
# stable `gateway` service DNS name. Leave blank only when using a real host
# address instead.
WORKSPACE_DOCKER_NETWORK=deploy_default
WORKSPACE_GATEWAY_URL=http://gateway:8080

# SQLite path for the gateway's tenant/auth/integrations state, as seen
# from inside the gateway's own container.
DATABASE_URL=sqlite://./data/gateway.db
