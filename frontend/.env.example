# Frontend's own config. Copy to .env for local dev:
#   cp .env.example .env
# .env is gitignored; never commit real values. Vite only exposes
# variables prefixed VITE_ to client code (see src/lib/env.ts).

# Base URL of rust_gateway (see ../rust_gateway/.env.example's
# GATEWAY_HOST/GATEWAY_PORT — must match whatever that process actually
# binds to). No trailing slash. Workspaces AND per-workspace onboarding
# (`/workspaces/:id/onboarding/*`) both go through this origin — never
# call the wrapper's own listen address from the browser.
VITE_GATEWAY_URL=http://127.0.0.1:8080
