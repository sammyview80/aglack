# Path to the pinned upstream Hermes Web UI checkout. Defaults to
# ../upstream relative to this wrapper project's root when unset.
HERMES_WEBUI_UPSTREAM=../upstream

# Optional override of the expected pinned upstream revision (see
# ../UPSTREAM.md). Defaults to the exact commit hash below; bootstrap
# fails closed if the checkout's HEAD doesn't match.
# HERMES_WEBUI_UPSTREAM_REVISION=e168b67e4278df618d1cab61fdb3a8dc55b29a81

# Isolated "home" directory upstream/state code resolves paths under.
# ALWAYS point this at a scratch directory in dev/test — never a real
# user home.
HERMES_HOME=/tmp/hermes-webui-wrapper-home

# Isolated state/session/workspace directories used by the best-effort
# runtime parity layer (hermes_webui_wrapper/runtime.py).
HERMES_WEBUI_STATE_DIR=/tmp/hermes-webui-wrapper-home/state
HERMES_WEBUI_SESSION_DIR=/tmp/hermes-webui-wrapper-home/state/sessions
HERMES_WEBUI_DEFAULT_WORKSPACE=/tmp/hermes-webui-wrapper-home/workspace

# Set to "false" to disable the best-effort runtime parity layer entirely
# (gateway watcher / drain thread / session reaper / plugin loading).
# Tests always set this to false. Defaults to "true".
HERMES_WRAPPER_RUNTIME_ENABLED=true

# Host/port the wrapper's own uvicorn process binds to.
HERMES_WRAPPER_HOST=127.0.0.1
HERMES_WRAPPER_PORT=8787
