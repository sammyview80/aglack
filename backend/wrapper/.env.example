# Path to the pinned upstream Hermes Web UI checkout. Defaults to
# ../upstream relative to this wrapper project's root when unset.
HERMES_WEBUI_UPSTREAM=../upstream

# Path to the seeder CONTENT tree (agents/tools/skills per mode — see
# ../seeder/README.md) applied by the agent-seeder feature. Defaults to
# ../seeder relative to this wrapper project's root when unset (the exact
# sibling layout both the source checkout and the workspace Docker image
# use), so this normally never needs setting — override only to point
# seeding at a different tree (e.g. a test rig or a deployment that keeps
# seed content elsewhere).
# HERMES_SEEDER_ROOT=../seeder

# Optional override of the expected pinned upstream revision (see
# ../UPSTREAM.md). Defaults to the exact commit hash below; bootstrap
# fails closed if the checkout's HEAD doesn't match.
# HERMES_WEBUI_UPSTREAM_REVISION=e168b67e4278df618d1cab61fdb3a8dc55b29a81

# Isolated "home" directory upstream/state code resolves paths under.
# ALWAYS point this at a scratch directory in dev/test — never a real
# user home.
HERMES_HOME=/tmp/hermes-webui-wrapper-home

# Isolated state/session/workspace directories used by the best-effort
# runtime parity layer (hermes_webui_wrapper/runtime.py).
#
# HERMES_WEBUI_DEFAULT_WORKSPACE also doubles as the source of the
# agent-seeder feature's PER-AGENT workspaces root: each newly seeded
# agent gets its own <parent-of-this-path>/<agent-slug>/ directory (e.g.
# /workspace/pm, a sibling of this value's own /workspace/default) — see
# config.py's resolve_agent_workspaces_root() and
# features/agent_seeder/service.py's _ensure_agent_workspace. Unset here
# means seeding still runs but skips creating a workspace / writing
# workspace-level AGENTS.md for any newly seeded agent.
HERMES_WEBUI_STATE_DIR=/tmp/hermes-webui-wrapper-home/state
HERMES_WEBUI_SESSION_DIR=/tmp/hermes-webui-wrapper-home/state/sessions
HERMES_WEBUI_DEFAULT_WORKSPACE=/tmp/hermes-webui-wrapper-home/workspace

# Set to "false" to disable the best-effort runtime parity layer entirely
# (gateway watcher / drain thread / session reaper / plugin loading).
# Tests always set this to false. Defaults to "true".
HERMES_WRAPPER_RUNTIME_ENABLED=true

# Host/port the wrapper's own uvicorn process binds to.
HERMES_WRAPPER_HOST=127.0.0.1
HERMES_WRAPPER_PORT=8787

# Origin allowed to make browser (CORS) requests to native
# /api/wrapper/v1/* routes. Must match the Vite origin exactly
# (open the app at http://localhost:5173, not http://127.0.0.1:5173).
# Same value as rust_gateway's FRONTEND_ORIGIN.
HERMES_FRONTEND_ORIGIN=http://localhost:5173

# A DIFFERENT var from HERMES_FRONTEND_ORIGIN above (CORS only) — read by
# transport/handler.py's align_loopback_proxy_host(). When a browser's
# Origin reaches this wrapper through a reverse proxy that rewrote/
# stripped Host (e.g. rust_gateway's forward_to), Origin and Host stop
# matching and upstream's CSRF check rejects the request with "Cross-
# origin mismatch - check reverse proxy headers" even for a legitimate
# same-machine session. Only rewrites Host when BOTH Origin and Host are
# loopback AND Origin is in this comma-separated allowlist — never for
# public hosts.
#
# Inside a real workspace container launched by rust_gateway, this is set
# AUTOMATICALLY by the boot script (see
# ../../rust_gateway/src/workspaces/container.rs's DockerCliLauncher —
# built from GatewayConfig::wrapper_allowed_origins(), which includes
# BOTH the configured frontend origin AND the gateway's own real listen
# address, since a browser may legitimately use either). This .env value
# only matters when running the wrapper standalone (outside a container,
# e.g. local wrapper-only dev) — set it to every origin YOUR browser
# actually uses to reach this process directly.
HERMES_WEBUI_ALLOWED_ORIGINS=http://localhost:5173
