# Shared environment variables — cross-cutting config used by 2+ services
# in this repo (backend/wrapper, rust_gateway, frontend). Anything used by
# only ONE service belongs in that service's own .env.example instead, not
# here (see each service's .env.example: backend/wrapper/.env.example,
# rust_gateway/.env.example, frontend/.env.example once those exist).
#
# Copy this file to .env.shared and fill in real values for local dev:
#   cp .env.shared.example .env.shared
# .env.shared is gitignored (see ../.gitignore's ".env" rule); never commit
# real values. Each service is expected to load .env.shared FIRST, then its
# own .env, so a service-specific .env can override a shared default if it
# ever needs to.
#
# NOTHING in this file should be secret enough that every service seeing it
# is a problem — if a value is sensitive AND only needed by one service, put
# it in that service's own .env instead so the blast radius stays small.

# ── Deployment environment ──────────────────────────────────────────────────
# One of: development | staging | production
APP_ENV=development

# Shared log verbosity convention across services (each service maps this to
# its own logging framework's levels as needed).
LOG_LEVEL=info

# ── Shared datastore (used by rust_gateway today; may be read by other
#    services later for tenant/auth lookups) ────────────────────────────────
# SQLite file path for the Rust gateway's tenant/auth/billing state. Chosen
# for Stage 1 (single machine, per backend/wrapper/docs/rust-gateway-
# architecture.md) — no separate DB server to run. Revisit and switch this
# to a real Postgres DATABASE_URL at Stage 2, when multiple Rust gateway
# instances need to share one datastore (SQLite has no good story for
# multiple writers across separate machines/processes over a network).
#
# IMPORTANT: this path is relative to wherever the gateway PROCESS runs
# from — `cargo run`/the built binary's working directory is
# rust_gateway/, NOT this file's own location (the repo root). So
# "./data/gateway.db" here means rust_gateway/data/gateway.db, not
# revamp/data/gateway.db. Point at an absolute path outside the repo for
# anything beyond local dev.
DATABASE_URL=sqlite://./data/gateway.db

# ── Shared network conventions ──────────────────────────────────────────────
# No shared network values yet. rust_gateway currently has its own
# self-contained host/port config (see rust_gateway/.env.example:
# GATEWAY_HOST, GATEWAY_PORT, GATEWAY_BACKEND_HOST, GATEWAY_BACKEND_PORT) —
# every value it needs is required and read there, nothing hardcoded.
# Once real per-tenant container routing exists, whatever shared addressing
# convention rust_gateway and backend/wrapper need to agree on (e.g. how the
# gateway discovers a tenant's wrapper port) belongs here instead of
# duplicated in both services' own .env.example files.
